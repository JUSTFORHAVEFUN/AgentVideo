#!/usr/bin/env python3
"""
vman.py — version.json 管理器（开发者工具）

用法:
    python vman.py                     管理当前目录的 version.json
    python vman.py path/to/version.json

菜单:
    r  release       扫描 .py 并发布新版本
    l  list          列出所有版本
    i  info          查看版本详情
    d  deprecate     标记版本废弃
    u  undeprecate   恢复废弃版本
    s  set-latest    设置 latest
    x  delete        删除版本
    v  verify        校验 version.json
    c  scan          预览当前 .py 哈希
    h  history       git 提交历史
    p  publish       git commit + push
    g  config        修改 repo / branch
    q  exit
"""
from __future__ import annotations

import argparse
import atexit
import fnmatch
import hashlib
import json
import os
import re
import select
import signal
import subprocess
import sys
import termios
import tty
from contextlib import contextmanager
from pathlib import Path

__version__ = '1.0.0'

# ============================================================
# 颜色
# ============================================================
_USE_COLOR = (
    hasattr(sys.stdout, 'isatty') and sys.stdout.isatty()
    and os.environ.get('NO_COLOR') is None
)


def _c(code, s):
    return '\033[' + code + 'm' + s + '\033[0m' if _USE_COLOR else s


def red(s):     return _c('31', s)
def green(s):   return _c('32', s)
def yellow(s):  return _c('33', s)
def blue(s):    return _c('34', s)
def magenta(s): return _c('35', s)
def cyan(s):    return _c('36', s)
def gray(s):    return _c('90', s)
def bold(s):    return _c('1', s)
def dim(s):     return _c('2', s)
def reverse(s): return _c('7', s)


_ANSI_RE = re.compile(r'\033\[[0-9;?]*[a-zA-Z]')


def strip_ansi(s):
    return _ANSI_RE.sub('', s)


def disp_width(s):
    s = strip_ansi(s)
    w = 0
    for ch in s:
        o = ord(ch)
        if (0x1100 <= o <= 0x115F or 0x2E80 <= o <= 0x303E or
                0x3041 <= o <= 0x33FF or 0x3400 <= o <= 0x4DBF or
                0x4E00 <= o <= 0x9FFF or 0xA000 <= o <= 0xA4CF or
                0xAC00 <= o <= 0xD7A3 or 0xF900 <= o <= 0xFAFF or
                0xFE30 <= o <= 0xFE4F or 0xFF00 <= o <= 0xFF60 or
                0xFFE0 <= o <= 0xFFE6 or 0x20000 <= o <= 0x3FFFD):
            w += 2
        else:
            w += 1
    return w


def truncate_to_width(s, max_w):
    if max_w <= 0:
        return ''
    if disp_width(s) <= max_w:
        return s
    out = []
    w = 0
    i = 0
    while i < len(s):
        if s[i] == '\033':
            m = _ANSI_RE.match(s, i)
            if m:
                out.append(m.group(0))
                i = m.end()
                continue
        cw = 2 if disp_width(s[i]) == 2 else 1
        if w + cw > max_w - 1:
            break
        out.append(s[i])
        w += cw
        i += 1
    out.append('…')
    out.append('\033[0m')
    return ''.join(out)


# ============================================================
# 屏幕控制（引用计数）
# ============================================================
_ALT_DEPTH = 0
_RAW_DEPTH = 0
_SAVED_TERMIOS = None


def can_use_raw():
    try:
        return sys.stdin.isatty() and sys.stdout.isatty()
    except Exception:
        return False


def _force_restore():
    global _ALT_DEPTH, _RAW_DEPTH, _SAVED_TERMIOS
    if _SAVED_TERMIOS is not None:
        try:
            termios.tcsetattr(sys.stdin.fileno(),
                              termios.TCSADRAIN, _SAVED_TERMIOS)
        except Exception:
            pass
        _SAVED_TERMIOS = None
    _RAW_DEPTH = 0
    if _ALT_DEPTH > 0:
        try:
            sys.stdout.write('\033[?25h\033[?1049l')
            sys.stdout.flush()
        except Exception:
            pass
        _ALT_DEPTH = 0


def enter_alt():
    global _ALT_DEPTH
    if not can_use_raw():
        _ALT_DEPTH += 1
        return
    if _ALT_DEPTH == 0:
        sys.stdout.write('\033[?1049h\033[?25l\033[2J\033[H')
        sys.stdout.flush()
    _ALT_DEPTH += 1


def exit_alt():
    global _ALT_DEPTH
    if _ALT_DEPTH <= 0:
        return
    _ALT_DEPTH -= 1
    if _ALT_DEPTH == 0 and can_use_raw():
        sys.stdout.write('\033[?25h\033[?1049l')
        sys.stdout.flush()


def enter_raw():
    global _RAW_DEPTH, _SAVED_TERMIOS
    if not can_use_raw():
        _RAW_DEPTH += 1
        return
    if _RAW_DEPTH == 0:
        try:
            _SAVED_TERMIOS = termios.tcgetattr(sys.stdin.fileno())
            tty.setraw(sys.stdin.fileno())
        except termios.error:
            _RAW_DEPTH += 1
            return
    _RAW_DEPTH += 1


def exit_raw():
    global _RAW_DEPTH, _SAVED_TERMIOS
    if _RAW_DEPTH <= 0:
        return
    _RAW_DEPTH -= 1
    if _RAW_DEPTH == 0 and _SAVED_TERMIOS is not None:
        try:
            termios.tcsetattr(sys.stdin.fileno(),
                              termios.TCSADRAIN, _SAVED_TERMIOS)
        except Exception:
            pass
        _SAVED_TERMIOS = None


@contextmanager
def tui_screen():
    enter_alt()
    enter_raw()
    try:
        yield
    finally:
        exit_raw()
        exit_alt()


def _term_size():
    try:
        s = os.get_terminal_size()
        return s.lines, s.columns
    except OSError:
        return 24, 80


def draw_screen(lines):
    rows, cols = _term_size()
    out = ['\033[H']
    for i in range(rows):
        out.append('\033[2K')
        if i < len(lines):
            out.append(truncate_to_width(lines[i], cols))
        if i < rows - 1:
            out.append('\r\n')
    out.append('\033[J')
    sys.stdout.write(''.join(out))
    sys.stdout.flush()


def set_cursor(row, col):
    sys.stdout.write('\033[{};{}H'.format(row, col))
    sys.stdout.flush()


# ============================================================
# 键盘
# ============================================================
KEY_UP = 'UP'
KEY_DOWN = 'DOWN'
KEY_LEFT = 'LEFT'
KEY_RIGHT = 'RIGHT'
KEY_TAB = 'TAB'
KEY_ENTER = 'ENTER'
KEY_ESC = 'ESC'
KEY_BACKSPACE = 'BACKSPACE'
KEY_DELETE = 'DELETE'
KEY_CTRL_C = 'CTRL_C'
KEY_CTRL_D = 'CTRL_D'
KEY_CTRL_U = 'CTRL_U'
KEY_CTRL_W = 'CTRL_W'
KEY_CTRL_L = 'CTRL_L'
KEY_CHAR = 'CHAR'
KEY_NONE = 'NONE'
KEY_HOME = 'HOME'
KEY_END = 'END'
KEY_PGUP = 'PGUP'
KEY_PGDN = 'PGDN'


def read_key(timeout=0.1):
    fd = sys.stdin.fileno()
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            return (KEY_NONE, '')
        b = os.read(fd, 1)
        if not b:
            return (KEY_CTRL_D, '')
        ch = b[0]
        if ch == 0x1b:
            r2, _, _ = select.select([fd], [], [], 0.03)
            if not r2:
                return (KEY_ESC, '')
            b2 = os.read(fd, 1)
            if b2 == b'[':
                r3, _, _ = select.select([fd], [], [], 0.03)
                if not r3:
                    return (KEY_ESC, '[')
                b3 = os.read(fd, 1)
                if b3 == b'A': return (KEY_UP, '')
                if b3 == b'B': return (KEY_DOWN, '')
                if b3 == b'C': return (KEY_RIGHT, '')
                if b3 == b'D': return (KEY_LEFT, '')
                if b3 == b'Z': return (KEY_TAB, 'shift')
                if b3 == b'H': return (KEY_HOME, '')
                if b3 == b'F': return (KEY_END, '')
                if b3.isdigit():
                    r4, _, _ = select.select([fd], [], [], 0.03)
                    if r4:
                        b4 = os.read(fd, 1)
                        if b4 == b'~':
                            if b3 == b'3': return (KEY_DELETE, '')
                            if b3 == b'1': return (KEY_HOME, '')
                            if b3 == b'4': return (KEY_END, '')
                            if b3 == b'5': return (KEY_PGUP, '')
                            if b3 == b'6': return (KEY_PGDN, '')
                return (KEY_NONE, '')
            elif b2 == b'O':
                r3, _, _ = select.select([fd], [], [], 0.03)
                if not r3:
                    return (KEY_NONE, '')
                b3 = os.read(fd, 1)
                if b3 == b'A': return (KEY_UP, '')
                if b3 == b'B': return (KEY_DOWN, '')
                if b3 == b'C': return (KEY_RIGHT, '')
                if b3 == b'D': return (KEY_LEFT, '')
                if b3 == b'H': return (KEY_HOME, '')
                if b3 == b'F': return (KEY_END, '')
                return (KEY_NONE, '')
            else:
                return (KEY_ESC, b2.decode('ascii', 'replace'))
        if ch == 0x09: return (KEY_TAB, '')
        if ch in (0x0a, 0x0d): return (KEY_ENTER, '')
        if ch in (0x7f, 0x08): return (KEY_BACKSPACE, '')
        if ch == 0x03: return (KEY_CTRL_C, '')
        if ch == 0x04: return (KEY_CTRL_D, '')
        if ch == 0x15: return (KEY_CTRL_U, '')
        if ch == 0x17: return (KEY_CTRL_W, '')
        if ch == 0x0c: return (KEY_CTRL_L, '')
        if ch < 0x80:
            return (KEY_CHAR, chr(ch))
        n = 0
        if ch & 0xE0 == 0xC0: n = 2
        elif ch & 0xF0 == 0xE0: n = 3
        elif ch & 0xF8 == 0xF0: n = 4
        buf = bytes([ch])
        for _ in range(n - 1):
            nb = os.read(fd, 1)
            if not nb:
                break
            buf += nb
        try:
            return (KEY_CHAR, buf.decode('utf-8'))
        except UnicodeDecodeError:
            return (KEY_CHAR, '?')
    except OSError:
        return (KEY_NONE, '')


# ============================================================
# 基础组件
# ============================================================
def prompt_line(title='', prompt='', default='', allow_empty=True):
    if not can_use_raw():
        try:
            h = ' [' + default + ']' if default else ''
            r = input(strip_ansi(title) + '\n' +
                      strip_ansi(prompt) + h + ': ').strip()
            if not r and not allow_empty:
                return None
            return r or default
        except (EOFError, KeyboardInterrupt):
            return None
    buf = list(default)
    pos = len(buf)
    with tui_screen():
        while True:
            lines = []
            if title:
                lines.append(bold(cyan(title)))
                lines.append('')
            lines.append(prompt + ''.join(buf))
            lines.append('')
            lines.append(gray('Enter 确认 · Esc 取消'))
            draw_screen(lines)
            cr = (2 if title else 0) + 1
            pw = disp_width(prompt)
            cc = pw + disp_width(''.join(buf[:pos])) + 1
            cc = max(1, min(cc, _term_size()[1]))
            set_cursor(cr, cc)
            kind, ch = read_key(0.15)
            if kind == KEY_NONE:
                continue
            if kind == KEY_ENTER:
                if not allow_empty and not buf and not default:
                    continue
                return ''.join(buf).strip() or default
            if kind in (KEY_ESC, KEY_CTRL_C):
                return None
            if kind == KEY_CTRL_D and not buf:
                return None
            if kind == KEY_CTRL_U:
                buf = buf[:pos]
                del buf[pos:]
                continue
            if kind == KEY_CTRL_W:
                while pos > 0 and buf[pos - 1] == ' ':
                    del buf[pos - 1]
                    pos -= 1
                while pos > 0 and buf[pos - 1] != ' ':
                    del buf[pos - 1]
                    pos -= 1
                continue
            if kind == KEY_BACKSPACE:
                if pos > 0:
                    del buf[pos - 1]
                    pos -= 1
            elif kind == KEY_DELETE:
                if pos < len(buf):
                    del buf[pos]
            elif kind == KEY_LEFT:
                if pos > 0:
                    pos -= 1
            elif kind == KEY_RIGHT:
                if pos < len(buf):
                    pos += 1
            elif kind == KEY_HOME:
                pos = 0
            elif kind == KEY_END:
                pos = len(buf)
            elif kind == KEY_CHAR:
                if ch and ch.isprintable():
                    buf.insert(pos, ch)
                    pos += 1


def confirm_dialog(title, default=False):
    if not can_use_raw():
        suf = ' [Y/n] ' if default else ' [y/N] '
        try:
            a = input(strip_ansi(title) + suf).strip().lower()
            if not a:
                return default
            return a in ('y', 'yes')
        except (EOFError, KeyboardInterrupt):
            return False
    di = 0 if default else 1
    with tui_screen():
        sel = di
        while True:
            yes = reverse(bold('  Yes  ')) if sel == 0 else '  Yes  '
            no = reverse(bold('  No   ')) if sel == 1 else '  No   '
            draw_screen([bold(cyan(title)), '',
                         '   ' + yes + '   ' + no, '',
                         gray('←→ 选择 · Enter 确认 · Esc 取消 · Y/N 快捷')])
            k, ch = read_key(0.15)
            if k == KEY_NONE:
                continue
            if k == KEY_LEFT:
                sel = (sel - 1) % 2
            elif k == KEY_RIGHT:
                sel = (sel + 1) % 2
            elif k == KEY_ENTER:
                return sel == 0
            elif k in (KEY_ESC, KEY_CTRL_C):
                return False
            elif k == KEY_CHAR:
                c = ch.lower()
                if c == 'y': return True
                if c == 'n': return False


def message_box(title, body='', kind='info', wait_key=True):
    if not can_use_raw():
        print('\n' + strip_ansi(title))
        if body:
            print(body)
        if wait_key:
            try:
                input('按回车继续...')
            except (EOFError, KeyboardInterrupt):
                pass
        return
    icon = {'info': 'i', 'warn': '!', 'error': 'x', 'ok': 'v'}.get(kind, 'i')
    cf = {'info': cyan, 'warn': yellow,
          'error': red, 'ok': green}.get(kind, cyan)
    with tui_screen():
        while True:
            rows, cols = _term_size()
            bl = body.split('\n') if body else []
            mb = rows - 6
            if len(bl) > mb:
                bl = bl[:mb - 1] + [
                    dim(gray('... 还有 ' + str(len(bl) - mb + 1) + ' 行'))]
            lines = [cf(bold('  [' + icon + ']  ' + title))]
            if bl:
                lines.append('')
                for l in bl:
                    lines.append('   ' + l)
            if wait_key:
                lines.append('')
                lines.append(gray('   按任意键继续...'))
            draw_screen(lines)
            if wait_key:
                k, _ = read_key(0.2)
                if k != KEY_NONE:
                    return
            else:
                return


def run_menu(items, title='', subtitle='', initial=0):
    if not items:
        return None
    if not can_use_raw():
        return _fb_menu(items, title)
    n = len(items)
    sel = max(0, min(initial, n - 1))
    if items[sel].get('disabled'):
        for i in range(n):
            if not items[i].get('disabled'):
                sel = i
                break
    with tui_screen():
        while True:
            lines = []
            if title:
                lines.append(bold(cyan(title)))
            if subtitle:
                lines.append(gray(subtitle))
            if title or subtitle:
                lines.append('')
            for i, it in enumerate(items):
                dis = it.get('disabled', False)
                lb = it.get('label', '')
                hi = it.get('hint', '')
                if dis:
                    lines.append('   ' + gray(lb) +
                                 (gray('  ' + hi) if hi else ''))
                elif i == sel:
                    lines.append(green(' > ') + bold(green(lb)) +
                                 (gray('  ' + hi) if hi else ''))
                else:
                    lines.append('   ' + lb +
                                 (gray('  ' + hi) if hi else ''))
            draw_screen(lines)
            k, ch = read_key(0.15)
            if k == KEY_NONE:
                continue
            if k == KEY_UP:
                for _ in range(n):
                    sel = (sel - 1) % n
                    if not items[sel].get('disabled'):
                        break
            elif k == KEY_DOWN:
                for _ in range(n):
                    sel = (sel + 1) % n
                    if not items[sel].get('disabled'):
                        break
            elif k == KEY_ENTER:
                if not items[sel].get('disabled'):
                    return items[sel].get('value')
            elif k in (KEY_ESC, KEY_CTRL_C, KEY_CTRL_D):
                return None
            elif k == KEY_CHAR:
                for it in items:
                    kk = it.get('key', '')
                    if kk and kk.lower() == ch.lower():
                        if not it.get('disabled'):
                            return it.get('value')


def _fb_menu(items, title=''):
    print()
    if title:
        print(bold(title))
    for i, it in enumerate(items):
        if it.get('disabled'):
            print('   ' + str(i + 1) + ') ' + gray(it.get('label', '')))
        else:
            print('   ' + str(i + 1) + ') ' + it.get('label', ''))
    try:
        r = input(bold('选择: ')).strip()
        idx = int(r) - 1
        if 0 <= idx < len(items) and not items[idx].get('disabled'):
            return items[idx].get('value')
    except (ValueError, EOFError, KeyboardInterrupt):
        pass
    return None


def _loading(msg):
    if can_use_raw():
        draw_screen([gray('  ... ' + msg)])


# ============================================================
# VersionDB
# ============================================================
IGNORE_DIRS = {
    '.git', '.hg', '.svn', '__pycache__', 'node_modules',
    'tmp', 'backups', 'vcompare', 'contrast', 'compare_out',
    '.vscode', '.idea', '.pytest_cache', '.mypy_cache',
    'moss_tts', 'build', 'dist', '.venv', 'venv', 'env', '_update',
}
IGNORE_NAMES = {'version.json', 'vman.py', 'studio.py', 'studio.conf.json'}
IGNORE_PATTERNS = ['*.bak', '*.bak_*', '*.orig', '*.pyc', '*.pyo', '*.log']


def _should_ignore(p, root):
    try:
        rel = p.relative_to(root)
    except ValueError:
        return True
    for part in rel.parts:
        if part in IGNORE_DIRS:
            return True
    if p.name in IGNORE_NAMES:
        return True
    for pat in IGNORE_PATTERNS:
        if fnmatch.fnmatch(p.name, pat):
            return True
    return False


def parse_ver(v):
    parts = []
    for x in str(v).split('.'):
        try:
            parts.append(int(x))
        except ValueError:
            parts.append(0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])


class VersionDB:
    def __init__(self, path):
        self.path = Path(path)
        self.data = self._load()

    def _load(self):
        if not self.path.exists():
            return {
                'latest': '',
                'supported': [],
                'deprecated': [],
                'repo': {'owner': '', 'name': '', 'branch': 'master'},
                'hashes': {},
            }
        try:
            d = json.loads(self.path.read_text(encoding='utf-8'))
        except Exception as e:
            print('WARN: version.json 读取失败: ' + str(e))
            d = {}
        if not isinstance(d, dict):
            d = {}
        d.setdefault('latest', '')
        d.setdefault('supported', [])
        d.setdefault('deprecated', [])
        d.setdefault('hashes', {})
        repo = d.setdefault('repo', {})
        repo.setdefault('owner', '')
        repo.setdefault('name', '')
        repo.setdefault('branch', 'master')
        return d

    def save(self):
        txt = json.dumps(self.data, indent=2,
                         ensure_ascii=False, sort_keys=False)
        self.path.write_text(txt + '\n', encoding='utf-8')

    def scan(self, root):
        result = {}
        for p in root.rglob('*.py'):
            if _should_ignore(p, root):
                continue
            h = hashlib.sha256(p.read_bytes()).hexdigest()
            rel = str(p.relative_to(root)).replace(os.sep, '/')
            result[rel] = 'sha256:' + h
        return dict(sorted(result.items()))

    def release(self, version, hashes):
        self.data.setdefault('hashes', {})[version] = hashes
        supported = self.data.setdefault('supported', [])
        if version not in supported:
            supported.append(version)
            supported.sort(key=parse_ver)
        l = self.data.get('latest', '')
        if not l or parse_ver(version) >= parse_ver(l):
            self.data['latest'] = version
        dep = self.data.get('deprecated', [])
        if version in dep:
            dep.remove(version)
        self.save()

    def deprecate(self, version):
        supported = self.data.get('supported', [])
        if version not in supported:
            return False
        supported.remove(version)
        dep = self.data.setdefault('deprecated', [])
        if version not in dep:
            dep.append(version)
            dep.sort(key=parse_ver)
        if self.data.get('latest') == version:
            self.data['latest'] = supported[-1] if supported else ''
        self.save()
        return True

    def undeprecate(self, version):
        dep = self.data.get('deprecated', [])
        if version not in dep:
            return False
        dep.remove(version)
        supported = self.data.setdefault('supported', [])
        if version not in supported:
            supported.append(version)
            supported.sort(key=parse_ver)
        self.save()
        return True

    def set_latest(self, version):
        if version not in self.data.get('hashes', {}):
            return False
        self.data['latest'] = version
        self.save()
        return True

    def delete_version(self, version):
        hashes = self.data.get('hashes', {})
        if version not in hashes:
            return False
        del hashes[version]
        for key in ('supported', 'deprecated'):
            arr = self.data.get(key, [])
            if version in arr:
                arr.remove(version)
        if self.data.get('latest') == version:
            sup = self.data.get('supported', [])
            self.data['latest'] = sup[-1] if sup else ''
        self.save()
        return True

    def list_versions(self):
        sup = set(self.data.get('supported', []))
        dep = set(self.data.get('deprecated', []))
        hashes = self.data.get('hashes', {})
        out = []
        for v in sorted(hashes.keys(), key=parse_ver):
            if v in sup:
                st = 'supported'
            elif v in dep:
                st = 'deprecated'
            else:
                st = 'orphan'
            out.append((v, st, len(hashes.get(v, {}))))
        return out


# ============================================================
# 操作
# ============================================================
def op_list(db):
    versions = db.list_versions()
    latest = db.data.get('latest', '')
    if not versions:
        message_box('空', '还没有任何版本。用 release 发布第一个版本。',
                    kind='info')
        return
    lines = []
    for v, st, n in reversed(versions):
        mark = ' * ' if v == latest else '   '
        if st == 'supported':
            st_s = green('supported ')
        elif st == 'deprecated':
            st_s = red('deprecated')
        else:
            st_s = yellow('orphan    ')
        lines.append(mark + bold(v) + '  ' + st_s +
                     '  ' + str(n) + ' 文件')
    message_box('版本列表 (' + str(len(versions)) + ' 个)',
                '\n'.join(lines))


def op_release(db, root):
    ver = prompt_line('发布新版本', '版本号 (如 1.2.0): ',
                      allow_empty=False)
    if not ver:
        return
    ver = ver.strip()
    if not re.match(r'^\d+(\.\d+)*$', ver):
        message_box('错误', '版本号格式：X / X.Y / X.Y.Z', kind='error')
        return
    if ver in db.data.get('hashes', {}):
        if not confirm_dialog('版本 ' + ver + ' 已存在，覆盖?'):
            return
    with tui_screen():
        _loading('扫描 .py 文件...')
        files = db.scan(root)
    if not files:
        message_box('没扫到', '当前目录没有 .py 文件', kind='warn')
        return
    lines = ['版本:   ' + ver,
             '文件数: ' + str(len(files)),
             '']
    for name, h in list(files.items())[:25]:
        lines.append('  ' + h[7:15] + '...  ' + name)
    if len(files) > 25:
        lines.append('  ... 还有 ' + str(len(files) - 25) + ' 个')
    message_box('准备发布', '\n'.join(lines))
    if not confirm_dialog('写入 version.json?'):
        return
    db.release(ver, files)
    message_box('完成', '版本 ' + ver + ' 已保存', kind='ok')


def op_info(db):
    ver = prompt_line('查看版本', '版本号: ', allow_empty=False)
    if not ver:
        return
    ver = ver.strip()
    hashes = db.data.get('hashes', {}).get(ver)
    if not hashes:
        message_box('不存在', '版本 ' + ver + ' 不在 version.json 里',
                    kind='warn')
        return
    lines = ['版本:   ' + ver,
             '文件数: ' + str(len(hashes)),
             '']
    for name, h in hashes.items():
        lines.append('  ' + h[7:19] + '...  ' + name)
    message_box('版本详情', '\n'.join(lines))


def op_deprecate(db):
    versions = [v for v, st, _ in db.list_versions() if st == 'supported']
    if not versions:
        message_box('没有', '没有 supported 版本', kind='warn')
        return
    items = [{'label': v, 'value': v} for v in reversed(versions)]
    v = run_menu(items, title='选择要废弃的版本',
                 subtitle='Enter 确认 · Esc 返回')
    if not v:
        return
    if db.deprecate(v):
        message_box('完成', v + ' 已标记为 deprecated', kind='ok')


def op_undeprecate(db):
    dep = db.data.get('deprecated', [])
    if not dep:
        message_box('没有', '没有 deprecated 版本', kind='warn')
        return
    items = [{'label': v, 'value': v} for v in reversed(dep)]
    v = run_menu(items, title='选择要恢复的版本',
                 subtitle='Enter 确认 · Esc 返回')
    if not v:
        return
    if db.undeprecate(v):
        message_box('完成', v + ' 已恢复到 supported', kind='ok')


def op_set_latest(db):
    versions = [v for v, _, _ in db.list_versions()]
    if not versions:
        message_box('没有', '还没有版本', kind='warn')
        return
    cur = db.data.get('latest', '')
    items = [{'label': v + ('  *' if v == cur else ''), 'value': v}
             for v in reversed(versions)]
    v = run_menu(items, title='设为 latest',
                 subtitle='Enter 确认 · Esc 返回')
    if not v:
        return
    if db.set_latest(v):
        message_box('完成', 'latest = ' + v, kind='ok')


def op_delete(db):
    versions = [v for v, _, _ in db.list_versions()]
    if not versions:
        return
    items = [{'label': v, 'value': v} for v in reversed(versions)]
    v = run_menu(items, title='删除版本', subtitle='Enter 确认 · Esc 返回')
    if not v:
        return
    if not confirm_dialog('确定要删除版本 ' + v + '?'):
        return
    if db.delete_version(v):
        message_box('完成', v + ' 已删除', kind='ok')


def op_verify(db):
    errors = []
    l = db.data.get('latest', '')
    sup = db.data.get('supported', [])
    dep = db.data.get('deprecated', [])
    hs = db.data.get('hashes', {})
    if l and l not in sup:
        errors.append('latest (' + l + ') 不在 supported 里')
    for v in sup:
        if v not in hs:
            errors.append('supported 的 ' + v + ' 没有 hashes')
    for v in dep:
        if v in sup:
            errors.append(v + ' 同时在 supported 和 deprecated')
    if errors:
        message_box('发现问题 (' + str(len(errors)) + ')',
                    '\n'.join(errors), kind='error')
    else:
        message_box('校验通过',
                    'latest:     ' + (l or '(空)') + '\n' +
                    'supported:  ' + str(len(sup)) + ' 个\n' +
                    'deprecated: ' + str(len(dep)) + ' 个',
                    kind='ok')


def op_config(db):
    repo = db.data.get('repo', {})
    items = [
        {'key': 'o', 'label': 'owner',
         'hint': repo.get('owner', '(未设置)'), 'value': 'owner'},
        {'key': 'n', 'label': 'repo name',
         'hint': repo.get('name', '(未设置)'), 'value': 'name'},
        {'key': 'b', 'label': 'branch',
         'hint': repo.get('branch', 'master'), 'value': 'branch'},
    ]
    k = run_menu(items, title='配置',
                 subtitle='Enter 修改 · Esc 返回')
    if not k:
        return
    cur = repo.get(k, '')
    new = prompt_line('修改 ' + k, k + ' [' + cur + ']: ', default=cur)
    if new is None:
        return
    repo[k] = new.strip()
    db.data['repo'] = repo
    db.save()
    message_box('完成', k + ' = ' + repo[k], kind='ok')


def op_publish(db):
    if not db.path.exists():
        message_box('错误', 'version.json 不存在', kind='error')
        return
    cwd = str(db.path.parent)
    fname = db.path.name
    r = subprocess.run(['git', 'diff', '--quiet', '--', fname],
                       cwd=cwd, capture_output=True)
    if r.returncode == 0:
        message_box('无变更', 'version.json 没有修改', kind='info')
        return
    msg = prompt_line('发布', '提交消息: ',
                      default='release: update version.json')
    if not msg:
        return
    r = subprocess.run(['git', 'add', fname],
                       cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        message_box('git add 失败', (r.stderr or '').strip(),
                    kind='error')
        return
    r = subprocess.run(['git', 'commit', '-m', msg],
                       cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        message_box('git commit 失败', (r.stderr or '').strip(),
                    kind='error')
        return
    if confirm_dialog('已 commit。是否 git push?', default=True):
        r = subprocess.run(['git', 'push'], cwd=cwd,
                           capture_output=True, text=True)
        if r.returncode != 0:
            message_box('git push 失败', (r.stderr or '').strip(),
                        kind='error')
            return
        message_box('完成', '已 push', kind='ok')
    else:
        message_box('完成', '已 commit（未 push）', kind='ok')


def op_scan(db, root):
    with tui_screen():
        _loading('扫描中...')
        files = db.scan(root)
    if not files:
        message_box('空', '没有 .py 文件', kind='info')
        return
    lines = ['扫描到 ' + str(len(files)) + ' 个 .py 文件:', '']
    for name, h in list(files.items())[:40]:
        lines.append('  ' + h[7:15] + '...  ' + name)
    if len(files) > 40:
        lines.append('  ... 还有 ' + str(len(files) - 40) + ' 个')
    message_box('扫描结果', '\n'.join(lines))


def op_history(db):
    cwd = str(db.path.parent)
    fname = db.path.name
    r = subprocess.run(['git', 'log', '--oneline', '-20', '--', fname],
                       cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        message_box('错误', (r.stderr or '').strip() or 'git log 失败',
                    kind='error')
        return
    out = r.stdout.strip() or '(无历史)'
    message_box('version.json 提交历史', out)


# ============================================================
# 主菜单
# ============================================================
MENU = [
    {'key': 'r', 'label': 'release',     'hint': '扫描 .py 并发布新版本',
     'value': 'release'},
    {'key': 'l', 'label': 'list',        'hint': '列出所有版本',
     'value': 'list'},
    {'key': 'i', 'label': 'info',        'hint': '查看版本详情',
     'value': 'info'},
    {'key': 'd', 'label': 'deprecate',   'hint': '标记版本为废弃',
     'value': 'deprecate'},
    {'key': 'u', 'label': 'undeprecate', 'hint': '恢复已废弃版本',
     'value': 'undeprecate'},
    {'key': 's', 'label': 'set-latest',  'hint': '设置 latest 版本',
     'value': 'set_latest'},
    {'key': 'x', 'label': 'delete',      'hint': '删除版本',
     'value': 'delete'},
    {'key': 'v', 'label': 'verify',      'hint': '校验 version.json',
     'value': 'verify'},
    {'key': 'c', 'label': 'scan',        'hint': '预览当前 .py 哈希',
     'value': 'scan'},
    {'key': 'h', 'label': 'history',     'hint': 'git 提交历史',
     'value': 'history'},
    {'key': 'p', 'label': 'publish',     'hint': 'git commit + push',
     'value': 'publish'},
    {'key': 'g', 'label': 'config',      'hint': '修改 repo / branch',
     'value': 'config'},
    {'key': 'q', 'label': 'exit',        'hint': '退出',
     'value': 'exit'},
]


def main_loop(db, root):
    while True:
        latest = db.data.get('latest') or '(空)'
        repo = db.data.get('repo', {})
        repo_str = '{}/{}@{}'.format(
            repo.get('owner', '?'),
            repo.get('name', '?'),
            repo.get('branch', 'master'),
        )
        val = run_menu(
            MENU,
            title='vman - version.json 管理器',
            subtitle=('file: {}  |  latest: {}  |  repo: {}'
                      .format(db.path.name, latest, repo_str)),
        )
        if val is None or val == 'exit':
            print(gray('再见'))
            return
        if val == 'release':
            op_release(db, root)
        elif val == 'list':
            op_list(db)
        elif val == 'info':
            op_info(db)
        elif val == 'deprecate':
            op_deprecate(db)
        elif val == 'undeprecate':
            op_undeprecate(db)
        elif val == 'set_latest':
            op_set_latest(db)
        elif val == 'delete':
            op_delete(db)
        elif val == 'verify':
            op_verify(db)
        elif val == 'scan':
            op_scan(db, root)
        elif val == 'history':
            op_history(db)
        elif val == 'publish':
            op_publish(db)
        elif val == 'config':
            op_config(db)


# ============================================================
# 入口
# ============================================================
def main():
    ap = argparse.ArgumentParser(
        prog='vman',
        description='vman - version.json 管理器（开发者工具）')
    ap.add_argument('file', nargs='?', default='version.json',
                    help='version.json 路径（默认当前目录）')
    args = ap.parse_args()

    path = Path(args.file).resolve()
    if not path.name.endswith('.json'):
        path = path / 'version.json'
    root = path.parent

    db = VersionDB(path)

    atexit.register(_force_restore)

    def on_sigint(s, f):
        _force_restore()
        sys.exit(130)
    try:
        signal.signal(signal.SIGINT, on_sigint)
    except Exception:
        pass

    # 首次运行：不存在 → 询问创建
    if not path.exists():
        print('未找到 ' + str(path))
        if not confirm_dialog('创建新的 version.json?'):
            return 1
        db.save()
        print(green('已创建 ' + str(path)))

    try:
        main_loop(db, root)
    except KeyboardInterrupt:
        pass
    finally:
        _force_restore()
    return 0


if __name__ == '__main__':
    sys.exit(main() or 0)